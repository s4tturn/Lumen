#!/bin/sh
set -e
export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
DEVICE_ID="00008030-00122930119A802E"
BUILD_DIR="$(mktemp -d /tmp/lumen-build-XXXXXX)"
trap 'rm -rf "$BUILD_DIR"' EXIT
xcodebuild -project Lumen.xcodeproj -scheme Lumen -configuration Release -destination "platform=iOS,id=$DEVICE_ID" -derivedDataPath "$BUILD_DIR" build
/usr/bin/xcrun devicectl device install app --device "$DEVICE_ID" "$BUILD_DIR/Build/Products/Release-iphoneos/Lumen.app"
